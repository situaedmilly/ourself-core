[Unit]
Description=SELFTOSYS Root Intake (status-only, fail-closed)
After=network.target
[Service]
Type=simple
WorkingDirectory=%h/.local/share/ourself/selftosys-root-intake-v0.1
ExecStart=/usr/bin/python3 %h/.local/share/ourself/selftosys-root-intake-v0.1/server.py
Environment=SELFTOSYS_BIND_HOST=127.0.0.1
Environment=SELFTOSYS_BIND_PORT=49372
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
[Install]
WantedBy=default.target
