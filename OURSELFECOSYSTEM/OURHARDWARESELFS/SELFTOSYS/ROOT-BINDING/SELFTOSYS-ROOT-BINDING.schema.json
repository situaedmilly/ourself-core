{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ourself:selftosys:root-binding:v0.1",
  "title": "SELFTOSYS Root Binding Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "bindingId",
    "authorityPrincipal",
    "bindingState",
    "hardware",
    "roles",
    "qualification",
    "transport",
    "liveConnection",
    "decision"
  ],
  "properties": {
    "contract": {
      "const": "ourself.selftosys.root-binding.v0.1"
    },
    "bindingId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "authorityPrincipal": {
      "const": "OURSELF"
    },
    "bindingState": {
      "enum": [
        "UNBOUND",
        "EVIDENCE_INTAKE",
        "QUALIFICATION",
        "ADMITTED",
        "REJECTED"
      ]
    },
    "hardware": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidateId",
            "manufacturer",
            "model",
            "serialNumber",
            "firmwareVersion",
            "assetRecordRef",
            "physicalCustodyReceiptRef",
            "physicalLocation",
            "keyBoundaryDescription"
          ],
          "properties": {
            "candidateId": {
              "type": "string",
              "minLength": 1
            },
            "manufacturer": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "serialNumber": {
              "type": "string",
              "minLength": 1
            },
            "firmwareVersion": {
              "type": "string",
              "minLength": 1
            },
            "assetRecordRef": {
              "type": "string",
              "minLength": 1
            },
            "physicalCustodyReceiptRef": {
              "type": "string",
              "minLength": 1
            },
            "physicalLocation": {
              "type": "string",
              "minLength": 1
            },
            "keyBoundaryDescription": {
              "type": "string",
              "minLength": 1
            },
            "manufacturerRootDependency": {
              "type": "boolean"
            },
            "vendorHostedControlPlaneRequired": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCustodianIds",
        "rootApproverIds",
        "independentWitnessId",
        "endpointAdminIds",
        "portalSignerId",
        "roleSeparationVerified"
      ],
      "properties": {
        "rootCustodianIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootApproverIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independentWitnessId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "endpointAdminIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "portalSignerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "roleSeparationVerified": {
          "type": "boolean"
        },
        "separationEvidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "participantCount",
        "policyDigest",
        "independentEnforcementEvidenceRef"
      ],
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "participantCount": {
          "type": "integer",
          "minimum": 2
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "independentEnforcementEvidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryModel",
        "providerDiscretionRequired",
        "recoveryDrillEvidenceRef",
        "successionEvidenceRef"
      ],
      "properties": {
        "recoveryModel": {
          "type": "string",
          "minLength": 1
        },
        "providerDiscretionRequired": {
          "const": false
        },
        "recoveryDrillEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "successionEvidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicates",
        "allPredicatesPassed",
        "independentReviewComplete"
      ],
      "properties": {
        "predicates": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "allPredicatesPassed": {
          "type": "boolean"
        },
        "independentReviewComplete": {
          "type": "boolean"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "protocol",
        "endpoint",
        "peerIdentity",
        "trustAnchorFingerprint"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_CONFIGURED",
            "BOOTSTRAP_PENDING",
            "AUTHENTICATED",
            "REVOKED",
            "FAILED"
          ]
        },
        "protocol": {
          "enum": [
            "mTLS_1_3",
            "SSH_HOST_AND_USER_KEY",
            "OTHER_REVIEWED"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "peerIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "trustAnchorFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-fA-F0-9]{64})?$"
        },
        "mutualAuthenticationEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_CONFIGURED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "endpoint": {
                "type": "null"
              },
              "peerIdentity": {
                "type": "null"
              },
              "trustAnchorFingerprint": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "AUTHENTICATED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "mutualAuthenticationEvidenceRef",
              "authenticatedAt"
            ],
            "properties": {
              "endpoint": {
                "type": "string",
                "format": "uri"
              },
              "peerIdentity": {
                "type": "string",
                "minLength": 1
              },
              "trustAnchorFingerprint": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "liveConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_TESTED",
            "BLOCKED_ROOT_UNBOUND",
            "BLOCKED_TRANSPORT_UNAUTHENTICATED",
            "FAILED",
            "VERIFIED"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "challengeNonce": {
          "type": "string",
          "minLength": 16
        },
        "responseDigest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "responseSignatureRef": {
          "type": "string",
          "minLength": 1
        },
        "independentVerificationEvidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "checkedAt",
              "requestId",
              "challengeNonce",
              "responseDigest",
              "responseSignatureRef",
              "independentVerificationEvidenceRef"
            ]
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "blockingReasons"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "BLOCKED",
            "ADMITTED",
            "REFUSED"
          ]
        },
        "blockingReasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "admittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decisionEvidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicateId",
        "result",
        "evidenceRef",
        "evidenceSha256",
        "observedAt",
        "observerIdentity",
        "independentReviewerIdentity",
        "method",
        "limitations"
      ],
      "properties": {
        "predicateId": {
          "enum": [
            "H01",
            "H02",
            "H03",
            "H04",
            "H05",
            "H06",
            "H07",
            "H08",
            "H09",
            "H10",
            "H11",
            "H12"
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "observerIdentity": {
          "type": "string",
          "minLength": 1
        },
        "independentReviewerIdentity": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bindingState": {
            "const": "ADMITTED"
          }
        },
        "required": [
          "bindingState"
        ]
      },
      "then": {
        "required": [
          "quorum",
          "recovery"
        ],
        "properties": {
          "hardware": {
            "type": "object"
          },
          "qualification": {
            "properties": {
              "allPredicatesPassed": {
                "const": true
              },
              "independentReviewComplete": {
                "const": true
              },
              "predicates": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H01"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H02"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H03"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H04"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H05"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H06"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H07"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H08"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H09"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H10"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H11"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "predicateId": {
                          "const": "H12"
                        },
                        "result": {
                          "const": "PASS"
                        }
                      },
                      "required": [
                        "predicateId",
                        "result"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          },
          "transport": {
            "properties": {
              "state": {
                "const": "AUTHENTICATED"
              }
            }
          },
          "liveConnection": {
            "properties": {
              "state": {
                "const": "VERIFIED"
              }
            }
          },
          "decision": {
            "properties": {
              "disposition": {
                "const": "ADMITTED"
              }
            }
          },
          "roles": {
            "properties": {
              "rootCustodianIds": {
                "minItems": 2
              },
              "rootApproverIds": {
                "minItems": 2
              },
              "independentWitnessId": {
                "type": "string",
                "minLength": 1
              },
              "endpointAdminIds": {
                "minItems": 1
              },
              "portalSignerId": {
                "type": "string",
                "minLength": 1
              },
              "roleSeparationVerified": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bindingState": {
            "const": "UNBOUND"
          }
        },
        "required": [
          "bindingState"
        ]
      },
      "then": {
        "properties": {
          "hardware": {
            "type": "null"
          },
          "transport": {
            "properties": {
              "state": {
                "const": "NOT_CONFIGURED"
              },
              "endpoint": {
                "type": "null"
              },
              "peerIdentity": {
                "type": "null"
              },
              "trustAnchorFingerprint": {
                "type": "null"
              }
            }
          },
          "liveConnection": {
            "properties": {
              "state": {
                "enum": [
                  "NOT_TESTED",
                  "BLOCKED_ROOT_UNBOUND"
                ]
              }
            }
          },
          "decision": {
            "properties": {
              "disposition": {
                "const": "BLOCKED"
              }
            }
          }
        }
      }
    }
  ]
}
